{
  "name": "apmd2",
  "version": "1.0.9",
  "description": "A Node.js wrapper for the Apple API (Unofficial) http://apple.com",
  "keywords": [
    "api",
    "apple",
    "apple.music",
    "music",
    "wrapper"
  ],
  "license": "MIT",
  "author": "Dirold2",
  "contributors": [
    "Dirold2 (https://github.com/dirold2)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dirold2/apmd2.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun run clean && tsc && bun run d-esbuild && d-build && bun run clean:maps",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "publish": "npm run build && d-publish",

    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",

    "typecheck:examples": "tsc -p tsconfig.examples.json",

    "test:providers": "node --import tsx tests/providers.ts",
    "test:retry": "node --import tsx tests/retry.ts",
    "test:daily-charts": "node --import tsx --test tests/daily-charts.ts",
    "test:new-releases": "node --import tsx --test tests/new-releases.ts",
    "test": "npm run test:providers && npm run test:retry && npm run test:daily-charts && npm run test:new-releases",

    "smoke:track": "dotenv -e .env -- tsx example/track.ts",
    "smoke:summary": "tsx smoke-runner.ts"
  },
  "dependencies": {
    "hcacher": "^0.3.1",
    "hyperttp": "^0.7.10",
    "node-html-parser": "^9.0.7"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/node": "^26.6.11",
    "chalk": "^6.0.1",
    "dotenv-cli": "^11.1.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
